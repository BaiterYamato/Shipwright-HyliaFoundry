  "capabilityRationales": {
    "core.items.v1": "Declara o martelo de prova da maquina de estados.",
    "core.input.v1": "Fornece a entrada de press, hold e release.",
    "items.state_machine.v1": "Demonstra select, deselect, press, hold, release e impact no runtime API v4."
  },
  "dependencies": [],
  "permissions": []
}
