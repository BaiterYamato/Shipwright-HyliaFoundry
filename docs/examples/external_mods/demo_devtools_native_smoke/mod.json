{
    "id":  "com.sylian.demo.devtools_native_smoke",
    "name":  "Demo Devtools Native Smoke",
    "version":  "0.1.0",
    "type":  "content",
    "apiVersion":  4,
    "uiCategory":  "mod",
    "loadPriority":  295,
    "entryScript":  "scripts/init.json",
    "runtime":  {
                    "type":  "hybrid-v1",
                    "module":  "scripts/noop.wat",
                    "entryLibrary":  "native/win64/plugin.dll",
                    "abiVersion":  1,
                    "nativeMode":  "sdk",
                    "reloadPolicy":  "manual",
                    "buildIdPolicy":  "ignore",
                    "threadModel":  "main_thread",
                    "maxMemoryKb":  1024,
                    "maxCallMs":  2,
                    "maxFrameBudgetMs":  2,
                    "maxHookCallsPerFrame":  256,
                    "maxActorInstances":  64,
                    "maxActiveStatuses":  256
                },
    "hookDefinitions":  "hooks/hooks.json",
    "assetSourceDefinitions":  "assets/sources.json",
    "settings":  {
                     "schemaVersion":  1,
                     "schemaFile":  "settings/settings.schema.json",
                     "defaultDomain":  "global"
                 },
    "engineVersionRange":  "\u003e=9.1.2 \u003c10.0.0",
    "releaseChannels":  [
                            "stable"
                        ],
    "capabilities":  [
                         "native.sdk.v1",
                         "assets.raw.v1",
                         "hooks.extended.v1"
                     ],
    "capabilityRationales":  {
                                 "native.sdk.v1":  "Declares native.sdk.v1 as part of Demo Devtools Native Smoke in the framework-first API v4 catalog.",
                                 "assets.raw.v1":  "Declares assets.raw.v1 as part of Demo Devtools Native Smoke in the framework-first API v4 catalog.",
                                 "hooks.extended.v1":  "Declares hooks.extended.v1 as part of Demo Devtools Native Smoke in the framework-first API v4 catalog."
                             },
    "permissions":  [
                        "nativeinterop"
                    ],
    "permissionRationales":  {
                                 "nativeinterop":  "Required by Demo Devtools Native Smoke for the configured runtime and diagnostics surface."
                             },
    "dependencies":  [
                         {
                             "id":  "com.sylian.framework.devtools_native",
                             "versionRange":  "\u003e=0.1.0 \u003c0.2.0"
                         }
                     ],
    "uses":  [
                 "framework.devtools_native"
             ],
    "exports":  {

                }
}
