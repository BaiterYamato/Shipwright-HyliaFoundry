{
    "id":  "com.sylian.reference.live_settings",
    "name":  "Reference Live Settings",
    "version":  "0.1.0",
    "type":  "content",
    "apiVersion":  4,
    "uiCategory":  "mod",
    "loadPriority":  210,
    "entryScript":  "scripts/init.json",
    "runtime":  {
                    "type":  "wasm3-v1",
                    "module":  "scripts/noop.wat",
                    "maxMemoryKb":  1024,
                    "maxCallMs":  2,
                    "maxFrameBudgetMs":  2,
                    "maxHookCallsPerFrame":  256,
                    "maxActorInstances":  64,
                    "maxActiveStatuses":  256
                },
    "hookDefinitions":  "hooks/hooks.json",
    "settings":  {
                     "schemaVersion":  1,
                     "schemaFile":  "settings/settings.schema.json",
                     "defaultDomain":  "global"
                 },
