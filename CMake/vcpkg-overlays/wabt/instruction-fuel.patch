+Result DefinedFunc::CallWithInstructionLimit(
+    Store& store,
+    const Values& params,
+    Values& results,
+    u64 max_instructions,
+    u64* out_instructions_executed,
+    bool* out_exhausted,
+    Trap::Ptr* out_trap) {
+  assert(params.size() == type_.params.size());
+  if (out_instructions_executed) {
+    *out_instructions_executed = 0;
+  }
+  if (out_exhausted) {
+    *out_exhausted = false;
+  }
+
+  Thread thread(store);
+  thread.PushValues(type_.params, params);
+  RunResult run_result = thread.PushCall(*this, out_trap);
+  if (run_result == RunResult::Trap) {
+    return Result::Error;
+  }
+
+  u64 remaining = max_instructions;
+  u64 executed_total = 0;
+  while (remaining > 0) {
+    const int chunk = static_cast<int>(std::min<u64>(
+        remaining, static_cast<u64>(std::numeric_limits<int>::max())));
+    int executed_chunk = 0;
+    run_result = thread.Run(chunk, &executed_chunk, out_trap);
+    executed_total += static_cast<u64>(executed_chunk);
+    remaining -= static_cast<u64>(executed_chunk);
+
+    if (run_result == RunResult::Trap) {
+      if (out_instructions_executed) {
+        *out_instructions_executed = executed_total;
+      }
+      return Result::Error;
+    }
+    if (run_result == RunResult::Exception) {
+      *out_trap = Trap::New(store, "uncaught exception");
+      if (out_instructions_executed) {
+        *out_instructions_executed = executed_total;
+      }
+      return Result::Error;
+    }
+    if (run_result == RunResult::Return) {
+      thread.PopValues(type_.results, &results);
+      if (out_instructions_executed) {
+        *out_instructions_executed = executed_total;
+      }
+      return Result::Ok;
+    }
+  }
+
+  if (out_instructions_executed) {
+    *out_instructions_executed = executed_total;
+  }
+  if (out_exhausted) {
+    *out_exhausted = true;
+  }
+  *out_trap = Trap::New(store, "instruction limit exceeded");
+  return Result::Error;
+}
