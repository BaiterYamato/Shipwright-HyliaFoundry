+
+RunResult Thread::Run(int num_instructions,
+                      int* out_instructions_executed,
+                      Trap::Ptr* out_trap) {
+  if (out_instructions_executed) {
+    *out_instructions_executed = 0;
+  }
   DefinedFunc::Ptr func{store_, frames_.back().func};
   for (; num_instructions > 0; --num_instructions) {
     auto result = StepInternal(out_trap);
+    if (out_instructions_executed) {
+      ++*out_instructions_executed;
+    }
     if (result != RunResult::Ok) {
       return result;
     }
   }
   return RunResult::Ok;
 }
