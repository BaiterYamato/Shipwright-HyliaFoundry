{
  "name": "wabt",
  "version": "1.0.41",
  "port-version": 1,
  "description": "WebAssembly Binary Toolkit with deterministic interpreter instruction fuel",
  "homepage": "https://github.com/WebAssembly/wabt/",
  "license": "Apache-2.0",
  "dependencies": [
    "picosha2",
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ],
  "features": {
    "instruction-fuel": {
      "description": "Expose deterministic instruction-limited interpreter calls"
    },
    "tools": {
      "description": "Build wabt commandline tools"
    },
    "wasm-rt-impl": {
      "description": "Include the WABT C runtime implementation library"
    }
  }
}
